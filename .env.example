VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Public Cloudflare Turnstile site key. Required for anonymous sign-in and the first AI analysis in production.
# TODO: set VITE_TURNSTILE_SITE_KEY before the public launch. A production build fails closed when it is empty.
VITE_TURNSTILE_SITE_KEY=

# AI analysis runs in the Supabase edge functions.
# Set these in the function environment, not in this file:
# - LOVABLE_API_KEY
# - TURNSTILE_SECRET_KEY  (Cloudflare Turnstile secret)
# - KANKAN_ENV=production  (missing TURNSTILE_SECRET_KEY then fails closed)
# Do not commit secrets.
